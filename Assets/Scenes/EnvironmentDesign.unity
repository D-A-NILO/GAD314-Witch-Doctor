  m_Script: {fileID: 11500000, guid: e8fe83d867730594faee1bbde16bb836, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  tutorialText: {fileID: 1472064636}
  typingSpeed: 0.03
  segments:
  - trigger: {fileID: 0}
    executeOnSegment:
      m_PersistentCalls:
        m_Calls: []
    text: Welcome to The Which Doctor Tutorial, use WASD to move around, try picking
      up the ingredient on the table with E / left click
  - trigger: {fileID: 1559525286}
    executeOnSegment:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1353021876}
          m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
          m_MethodName: SetActive
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    text: You can use Scroll Wheel to move the item closer / further
  - trigger: {fileID: 206128594}
    executeOnSegment:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1444625832}
          m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
          m_MethodName: SetActive
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 1
          m_CallState: 2
        - m_Target: {fileID: 1716838297}
          m_TargetAssemblyTypeName: UnityEngine.BoxCollider, UnityEngine
          m_MethodName: set_enabled
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 1
          m_CallState: 2
    text: Great, now take the ingredient and put it on the chopping board
  - trigger: {fileID: 1735832091}
    executeOnSegment:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1444625832}
          m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
          m_MethodName: SetActive
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    text: Grab the knife and hit the Sunpetal to chop it up!
  - trigger: {fileID: 1020212703}
    executeOnSegment:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 468877563}
          m_TargetAssemblyTypeName: PrefabSpawner, Assembly-CSharp
          m_MethodName: Spawn
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 1
          m_CallState: 2
        - m_Target: {fileID: 963571509}
          m_TargetAssemblyTypeName: TutorialGrinder, Assembly-CSharp
          m_MethodName: set_enabled
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 1
          m_CallState: 2
        - m_Target: {fileID: 963571511}
          m_TargetAssemblyTypeName: UnityEngine.BoxCollider, UnityEngine
          m_MethodName: set_enabled
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 1
          m_CallState: 2
        - m_Target: {fileID: 1928826024}
          m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
          m_MethodName: SetActive
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 1
          m_CallState: 2
    text: Here is a new Sunpetal, try crushing it with the mortar and pestle instead
  - trigger: {fileID: 204275482}
    executeOnSegment:
      m_PersistentCalls:
        m_Calls: []
    text: Oh no, That didn't quite work, ingredients can be overprocessed or may
      not be able to process in specific ways, this will result in trash
  - trigger: {fileID: 1672944321}
    executeOnSegment:
      m_PersistentCalls:
        m_Calls: []
    text: Time to make the potion, Add these 2 ingredients to the cauldron
  - trigger: {fileID: 1490627988}
    executeOnSegment:
      m_PersistentCalls:
        m_Calls: []
    text: To Mix the potion Grab the spoon and Stir the liquid
  - trigger: {fileID: 752984308}
    executeOnSegment:
      m_PersistentCalls:
        m_Calls: []
    text: The potion is mixed, now just bottle it in a potion bottle
  - trigger: {fileID: 413072718}
    executeOnSegment:
      m_PersistentCalls:
        m_Calls: []
    text: There are several potion recipes, press 'R' to check them out.
  - trigger: {fileID: 1742438865}
    executeOnSegment:
      m_PersistentCalls:
        m_Calls: []
    text: You don't seem to have the required ingredients. interact with the shop
      to order more
  - trigger: {fileID: 418223146}
    executeOnSegment:
      m_PersistentCalls:
        m_Calls: []
    text: Once you've ordered your ingredients they will be delivered outside. Try
      Crafting Any valid potion.
  - trigger: {fileID: 1058022457}
    executeOnSegment:
      m_PersistentCalls:
        m_Calls: []
    text: Perfect, it seems your first customer has arrived, go to your customer
      and interact with 'E' / left click to talk to them
  - trigger: {fileID: 643978554}
    executeOnSegment:
      m_PersistentCalls:
        m_Calls: []
    text: Patients will give you hints in their dialogue on which potion will cure
      them.
  - trigger: {fileID: 260785245}
    executeOnSegment:
      m_PersistentCalls:
        m_Calls: []
    text: Congradulations you are now a lisinsed doktar :0
  - trigger: {fileID: 1483312231}
    executeOnSegment:
      m_PersistentCalls:
        m_Calls: []
    text: This concludes the tutorial, feel free to try and cure some more patients!
  orderTriggerEvents: 1
