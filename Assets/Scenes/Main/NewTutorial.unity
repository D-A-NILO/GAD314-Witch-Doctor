--- !u!114 &1488882885
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1488882884}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 53bf15be725b47d4e9ddc76f3747e232, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialMain
  tutorialText: {fileID: 1472064636}
  steps:
  - instructionText: 'Welcome to your first day as a witch doctah. Here you will
      learn how to process ingredients and make different cures for your patient. '
    autoAdvance: 1
    delayTime: 5
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: Press E to pick up an ingredient from the shelf and place it
      on the chopping board
    autoAdvance: 0
    delayTime: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: Great! Now press E to pick up the knife.
    autoAdvance: 0
    delayTime: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: Move the knife up and down on the chopping board until the ingredient
      is processed. You can hold RMB to lock the camera in place
    autoAdvance: 0
    delayTime: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 963571513}
          m_TargetAssemblyTypeName: UnityEngine.BoxCollider, UnityEngine
          m_MethodName: set_enabled
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 1
          m_CallState: 2
  - instructionText: Great work with the knife, now pick another ingredient from
      the shelf and bring it to the mortar to crush them.
    autoAdvance: 0
    delayTime: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 0}
          m_TargetAssemblyTypeName: UnityEngine.BoxCollider, UnityEngine
          m_MethodName: 
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - instructionText: 'Great now press E to pick up the round pestle '
    autoAdvance: 0
    delayTime: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: Move the pestle up and down to crush the ingredients.
    autoAdvance: 0
    delayTime: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: 'Now lets try combining different ingredients to create a valid
      potion '
    autoAdvance: 1
    delayTime: 6
    OnStepStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 2052023845}
          m_TargetAssemblyTypeName: TutorialTransition, Assembly-CSharp
          m_MethodName: GoToStage
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 2
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - instructionText: 'Toss the Crushed Salt Crystal and the raw Ginger Root into
      the cauldron to prepare the ''Stone Foot Potion''. '
    autoAdvance: 0
    delayTime: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: 'Pick up the spoon and stir the cauldron until the potion changes
      color '
    autoAdvance: 0
    delayTime: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: Perfect! Now grab an empty glass bottle and dunk it into the
      cauldron to collect your potion.
    autoAdvance: 0
    delayTime: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: Welcome to your final test! You'll need ingredients to treat
      patients. Interact with the Shop catalogue on the desk.
    autoAdvance: 0
    delayTime: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 2052023845}
          m_TargetAssemblyTypeName: TutorialTransition, Assembly-CSharp
          m_MethodName: GoToStage
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 3
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - instructionText: Add the ingredients you need to the cart and place the order.
      Pick up the delivery package that spawns and open it!
    autoAdvance: 0
    delayTime: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: A messy clinic is a dangerous clinic. Place your  ingredients
      onto the storage shelf.
    autoAdvance: 1
    delayTime: 6
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: 'A patient has arrived! Press E to interact with the patient
      and check their symptoms. '
    autoAdvance: 0
    delayTime: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 406227957}
          m_TargetAssemblyTypeName: NPCSpawner, Assembly-CSharp
          m_MethodName: set_enabled
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 1
          m_CallState: 2
        - m_Target: {fileID: 406227957}
          m_TargetAssemblyTypeName: NPCSpawner, Assembly-CSharp
          m_MethodName: SpawnNPC
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - instructionText: Check the recipe book, brew the exact cure they need, and hand
      them the potion in a bottle. Don't make a mistake!
    autoAdvance: 0
    delayTime: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: Excellent work, Doctah. You are ready for your shift
    autoAdvance: 0
    delayTime: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: 'Grab the chopped ingredients from the table and toss them into
      the cauldron. '
    autoAdvance: 0
    delayTime: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: 'Grab the chopped ingredients from the table and toss them into
      the cauldron. '
    autoAdvance: 0
    delayTime: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
  - instructionText: 'Grab the chopped ingredients from the table and toss them into
      the cauldron. '
    autoAdvance: 0
    delayTime: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
